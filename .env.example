# Copy this to .env and replace the placeholder values.
# Do not commit real secrets to GitHub.
# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key; this is a JWT-like token usually beginning with eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Legacy alias still accepted in older scripts and some deployments:
# SUPABASE_SERVICE_KEY=eyJ...

# --- OpenAI ---
# Typical OpenAI key shape: sk-... or sk-proj-...
OPENAI_API_KEY=sk-proj-...
# Legacy alias still accepted by older tooling:
# OPENAI_KEY=sk-proj-...

# --- Evolution / WhatsApp ---
EVOLUTION_URL=http://localhost:8080
# This is a separate API key from Supabase/OpenAI and is usually a long opaque string.
EVOLUTION_API_KEY=replace-with-evolution-api-key
# Legacy alias still accepted by older tooling:
# EVOLUTION_KEY=replace-with-evolution-api-key
PLATFORM_EVOLUTION_INSTANCE=heysasa-platform
EVOLUTION_WEBHOOK_URL=https://your-domain.example.com/webhook/evolution

# --- App / engine runtime ---
DEBUG_TOKEN=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,https://heysasa.co.ke,https://www.heysasa.co.ke
FOLLOWUP_CORS_ORIGINS=http://localhost:5173,https://heysasa.co.ke,https://www.heysasa.co.ke
FOLLOWUP_ENGINE_PORT=3001
DEFAULT_PHONE_COUNTRY_CODE=254
SCHEDULER_POLL_INTERVAL_MS=30000
SENDER_POLL_INTERVAL_MS=5000

# Optional: if you run a single-business local setup
# SINGLE_BUSINESS_ID=heysasa-123
