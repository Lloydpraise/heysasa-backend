PORT=3001
FOLLOWUP_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Supabase service role or legacy service key; value is usually a JWT-like token starting with eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# legacy alias still accepted by the app:
# SUPABASE_SERVICE_KEY=eyJ...

# OpenAI key shape: starts with sk- or sk-proj-
OPENAI_API_KEY=sk-proj-...
# legacy alias still accepted by older tooling:
# OPENAI_KEY=sk-proj-...

# Evolution URL + API key are separate from Supabase/OpenAI
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-evolution-api-key
# legacy alias still accepted by older tooling:
# EVOLUTION_KEY=replace-with-evolution-api-key

PLATFORM_EVOLUTION_INSTANCE=
